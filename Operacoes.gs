function listarMinhasOS(d){const u=usuarioAtual_();if(u.Perfil!==APP.PERFIS.MOTORISTA)throw new Error('Acesso de motorista necessário.');if(!u.MotoristaID)throw new Error('Usuário sem motorista vinculado.');let lista=tabela_('OrdensServico').filter(x=>String(x.MotoristaID)===String(u.MotoristaID));if(d.status)lista=lista.filter(x=>x.Status===d.status);return lista.sort((a,b)=>new Date(a.DataProgramada)-new Date(b.DataProgramada)).map(os=>Object.assign({},os,{itens:tabela_('OSItens').filter(i=>String(i.OSID)===String(os.ID))}));}
