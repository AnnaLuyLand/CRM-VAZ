    const r=atualizarPorId_('OrdensServico',os.ID,{Status:APP.OS.CONCLUIDA,ConclusaoEm:agora,NomeSignatario:sanitizarTexto_(d.nomeSignatario,120),AssinaturaArquivoID:arquivos.assinaturaId,Observacoes:sanitizarTexto_(d.observacoes),AtualizadoEm:agora});recalcularLocacao_(os.LocacaoID);auditar_('CONCLUIR','OrdensServico',os.ID,r.antes,r.depois);return r.depois;
  }finally{lock.releaseLock();}
}
function recalcularLocacao_(locacaoId){const loc=buscarPor_('Locacoes','ID',locacaoId),it=tabela_('LocacaoItens').filter(i=>String(i.LocacaoID)===String(locacaoId)),fim=it.every(i=>[APP.ITEM.RETIRADO,APP.ITEM.CANCELADO,APP.ITEM.TROCADO].includes(i.Status)),entregues=it.some(i=>i.Status===APP.ITEM.ENTREGUE),extras=it.reduce((s,i)=>s+numero_(i.ValorAdicional),0),total=numero_(loc.ValorTotal)+extras,status=fim?APP.LOCACAO.FINALIZADA:entregues?APP.LOCACAO.ANDAMENTO:loc.StatusOperacional;atualizarPorId_('Locacoes',locacaoId,{StatusOperacional:status,ValorTotal:total,Saldo:Math.max(0,total-numero_(loc.ValorRecebido)),AtualizadoEm:agora_()});}

function salvarArquivosOS_(os,fotos,assinaturaBase64){
  const ano=String(new Date().getFullYear()),base=obterOuCriarPasta_(obterOuCriarPasta_(pastaRaiz_(),'Ordens de Serviço'),ano),locFolder=obterOuCriarPasta_(base,String(os.LocacaoID)),pasta=obterOuCriarPasta_(locFolder,os.Numero);let assinaturaId='';
  fotos.forEach((f,i)=>{const blob=base64ParaBlob_(f,'foto-'+(i+1)+'.jpg');const arq=pasta.createFile(blob);registrarArquivoOS_(os.ID,'Foto',arq);});
  const assinatura=pasta.createFile(base64ParaBlob_(assinaturaBase64,'assinatura.png'));assinaturaId=assinatura.getId();registrarArquivoOS_(os.ID,'Assinatura',assinatura);return {assinaturaId:assinaturaId};
}
function base64ParaBlob_(data,nome){const m=String(data).match(/^data:([^;]+);base64,(.+)$/);if(!m)throw new Error('Arquivo em formato inválido.');const bytes=Utilities.base64Decode(m[2]);if(bytes.length>6*1024*1024)throw new Error('Arquivo excede 6 MB.');return Utilities.newBlob(bytes,m[1],nome);}
function registrarArquivoOS_(osId,tipo,arquivo){inserir_('ArquivosOS',{ID:uuid_(),OSID:osId,Tipo:tipo,ArquivoID:arquivo.getId(),Nome:arquivo.getName(),MimeType:arquivo.getBlob().getContentType(),Tamanho:arquivo.getSize(),CriadoEm:agora_(),CriadoPor:emailAtual_()});}

