function concluirOS(d){
  const os=validarOsDoMotorista_(d.osId);if([APP.OS.CONCLUIDA,APP.OS.CANCELADA].includes(os.Status))throw new Error('OS já encerrada.');if(!Array.isArray(d.fotos)||d.fotos.length<2)throw new Error('Anexe no mínimo duas fotos.');exigir_(d,['assinaturaBase64','nomeSignatario']);const lock=LockService.getScriptLock();lock.waitLock(30000);
